{
  "name": "log-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "log": "bin/log"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --outdir dist --target bun",
    "build:exe": "bun build ./src/cli.ts --compile --outfile dist/log-cli",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e-smoke.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "stress:cmd": "bun run dist/cli.js --cmd \"node ./examples/high-volume-generator.mjs\" --summary-json"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^13.1.0",
    "handlebars": "^4.7.8",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "react-devtools-core": "^4.28.5",
    "react-dom": "^18.3.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@cogs/eslint-config": "^0.2.10",
    "@cogs/prettier-config": "^0.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "bun-types": "^1.3.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
